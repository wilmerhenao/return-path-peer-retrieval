# Local verification and editor by-products. Every scientific and reviewer-facing
# file in the release is tracked explicitly by the clean one-commit repository.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.DS_Store
*.swp
.venv/
.venv-*/
dist/

# LaTeX rebuild intermediates. The released paper/main.pdf remains tracked.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
